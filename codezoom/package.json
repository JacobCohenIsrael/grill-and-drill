{
  "name": "codezoom",
  "version": "1.1.0",
  "description": "Walk the architecture of a Unity or .NET C# project one type at a time: a UML view centred on one Focus, its Dependents above and Dependencies below, in your browser or through MCP tools for coding agents.",
  "keywords": [
    "unity",
    "csharp",
    "dotnet",
    "mcp",
    "uml",
    "architecture",
    "dependency-graph",
    "code-navigation"
  ],
  "homepage": "https://jacobcohenisrael.github.io/grill-and-drill/",
  "bugs": {
    "url": "https://github.com/JacobCohenIsrael/grill-and-drill/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacobCohenIsrael/grill-and-drill.git",
    "directory": "codezoom"
  },
  "license": "MIT",
  "author": "Jacob Cohen",
  "type": "module",
  "bin": {
    "codezoom": "bin/codezoom.js"
  },
  "files": [
    "bin",
    "dist/server",
    "data",
    "dist/web",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.23.3"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "rm -rf dist/server && tsc -p tsconfig.json",
    "build:web": "vite build",
    "check": "tsc -p tsconfig.json --noEmit && svelte-check --tsconfig ./tsconfig.web.json",
    "test": "npm run build:server && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "tree-sitter": "^0.25.1",
    "tree-sitter-c-sharp": "^0.23.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
